<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Priority?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="CONTROLLER_NAME"
            prefHeight="400.0" prefWidth="600.0">
    <VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
      alignment="CENTER" spacing="20" style="-fx-background-color: #FFFFFF;">
    
        <padding>
            <Insets top="40" right="40" bottom="40" left="40"/>
        </padding>
        
        <Label text="UniNexus" 
            style="-fx-font-size: 48; -fx-font-weight: bold; -fx-text-fill: #CC0000;"/>
        
        <Label text="Login" 
            style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #333333;"/>
        
        <VBox VBox.vgrow="NEVER" minHeight="10"/>
        
        <TextField promptText="Username" 
                maxWidth="300"
                style="-fx-font-size: 14; -fx-padding: 10; -fx-border-color: #CC0000; -fx-border-width: 2; -fx-border-radius: 4; -fx-background-radius: 4;"/>
        
        <PasswordField promptText="Password" 
                    maxWidth="300"
                    style="-fx-font-size: 14; -fx-padding: 10; -fx-border-color: #CC0000; -fx-border-width: 2; -fx-border-radius: 4; -fx-background-radius: 4;"/>
        
        <CheckBox text="Show Password" 
                style="-fx-font-size: 12; -fx-text-fill: #333333;"/>
        
        <VBox VBox.vgrow="NEVER" minHeight="10"/>
        
        <HBox alignment="CENTER" spacing="10">
            <Button text="Login" 
                    prefWidth="90"
                    style="-fx-font-size: 12; -fx-padding: 10 20 10 20; -fx-background-color: #CC0000; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand;"/>
            
            <Button text="Register" 
                    prefWidth="90"
                    style="-fx-font-size: 12; -fx-padding: 10 20 10 20; -fx-background-color: #CC0000; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand;"/>
            
            <Button text="Browse Listings" 
                    prefWidth="120"
                    style="-fx-font-size: 12; -fx-padding: 10 20 10 20; -fx-background-color: #CC0000; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand;"/>
        </HBox>
        
        <VBox VBox.vgrow="ALWAYS"/>
        
        <VBox alignment="CENTER" spacing="5">
            <Label text="Demo client: client / password123" 
                style="-fx-font-size: 11; -fx-text-fill: #999999;"/>
            
            <Label text="Demo admin: admin / password123" 
                style="-fx-font-size: 11; -fx-text-fill: #999999;"/>
        </VBox>
        
    </VBox>
</AnchorPane>


