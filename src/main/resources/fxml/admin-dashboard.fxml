<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/20"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.studentmarketplace.controller.AdminDashboardController"
            stylesheets="@../css/global.css"
            style="-fx-background-color: #f8fafc;">

    <!-- =============================================
         TOP HEADER
    ============================================== -->
    <top>
        <VBox spacing="10"
              style="-fx-background-color: white;
                     -fx-border-color: #e5e7eb;
                     -fx-border-width: 0 0 1 0;">
            <padding>
                <Insets top="16" right="24" bottom="16" left="24"/>
            </padding>

            <!-- HEADER ROW -->
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label fx:id="welcomeLabel"
                       text="Welcome Admin"
                       style="-fx-font-size: 22px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #9D2034;"/>
                <Pane HBox.hgrow="ALWAYS"/>

                <Button text="Refund Management"
                        onAction="#handleOpenRefundAdmin"
                        style="-fx-background-color: #9D2034;
                               -fx-text-fill: white;
                               -fx-font-size: 13px;
                               -fx-font-weight: bold;
                               -fx-background-radius: 8;
                               -fx-padding: 10 18;
                               -fx-cursor: hand;"/>
                <Button text="Refresh"
                        onAction="#handleRefresh"
                        style="-fx-background-color: #666666;
                               -fx-text-fill: white;
                               -fx-font-size: 13px;
                               -fx-font-weight: bold;
                               -fx-background-radius: 8;
                               -fx-padding: 10 18;
                               -fx-cursor: hand;"/>
                <Button text="Logout"
                        onAction="#handleLogout"
                        style="-fx-background-color: white;
                               -fx-text-fill: #9D2034;
                               -fx-font-size: 13px;
                               -fx-font-weight: bold;
                               -fx-border-color: #9D2034;
                               -fx-border-width: 1.5;
                               -fx-border-radius: 8;
                               -fx-background-radius: 8;
                               -fx-padding: 10 18;
                               -fx-cursor: hand;"/>
            </HBox>

            <!-- SEARCH + STATS -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="searchField"
                           promptText="Search by owner or title"
                           HBox.hgrow="ALWAYS"
                           style="-fx-background-color: white;
                                  -fx-control-inner-background: white;
                                  -fx-text-fill: #1a1a1a;
                                  -fx-border-color: #d0d0d0;
                                  -fx-border-radius: 8;
                                  -fx-background-radius: 8;
                                  -fx-padding: 10 14;"/>
                <Label fx:id="activePostsLabel"
                       text="Active: 0"
                       style="-fx-background-color: #fef2f2;
                              -fx-text-fill: #9D2034;
                              -fx-font-weight: bold;
                              -fx-font-size: 12px;
                              -fx-padding: 6 14;
                              -fx-background-radius: 20;
                              -fx-border-color: #fecaca;
                              -fx-border-radius: 20;"/>
                <Label fx:id="productPostsLabel"
                       text="Products: 0"
                       style="-fx-background-color: #fef2f2;
                              -fx-text-fill: #9D2034;
                              -fx-font-weight: bold;
                              -fx-font-size: 12px;
                              -fx-padding: 6 14;
                              -fx-background-radius: 20;
                              -fx-border-color: #fecaca;
                              -fx-border-radius: 20;"/>
                <Label fx:id="rentalPostsLabel"
                       text="Rentals: 0"
                       style="-fx-background-color: #fef2f2;
                              -fx-text-fill: #9D2034;
                              -fx-font-weight: bold;
                              -fx-font-size: 12px;
                              -fx-padding: 6 14;
                              -fx-background-radius: 20;
                              -fx-border-color: #fecaca;
                              -fx-border-radius: 20;"/>
                <Label fx:id="resourcePostsLabel"
                       text="Resources: 0"
                       style="-fx-background-color: #fef2f2;
                              -fx-text-fill: #9D2034;
                              -fx-font-weight: bold;
                              -fx-font-size: 12px;
                              -fx-padding: 6 14;
                              -fx-background-radius: 20;
                              -fx-border-color: #fecaca;
                              -fx-border-radius: 20;"/>
                <Label fx:id="flaggedItemsLabel"
                       text="Flagged: 0"
                       style="-fx-background-color: #9D2034;
                              -fx-text-fill: white;
                              -fx-font-weight: bold;
                              -fx-font-size: 12px;
                              -fx-padding: 6 14;
                              -fx-background-radius: 20;"/>
            </HBox>
        </VBox>
    </top>

    <!-- =============================================
         CENTER – TABBED CONTENT
    ============================================== -->
    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE"
                 style="-fx-background-color: transparent;">
            <tabs>

                <!-- ═══════════════════════════════════
                     TAB 1: USER MANAGEMENT
                ════════════════════════════════════ -->
                <Tab text="User Management">
                    <BorderPane style="-fx-background-color: transparent;">
                        <center>
                            <VBox spacing="14" VBox.vgrow="ALWAYS"
                                  style="-fx-background-color: transparent;">
                                <padding>
                                    <Insets top="20" right="28" bottom="20" left="28"/>
                                </padding>

                                <!-- Section header -->
                                <HBox alignment="CENTER_LEFT" spacing="10">
                                    <Label text="👤  All Registered Users"
                                           style="-fx-font-size: 17px;
                                                  -fx-font-weight: bold;
                                                  -fx-text-fill: #111827;"/>
                                    <Pane HBox.hgrow="ALWAYS"/>
                                    <Label text="Select a user to suspend or activate"
                                           style="-fx-font-size: 12px;
                                                  -fx-text-fill: #6b7280;"/>
                                </HBox>

                                <!-- Table card -->
                                <VBox spacing="0" VBox.vgrow="ALWAYS"
                                      style="-fx-background-color: white;
                                             -fx-background-radius: 14;
                                             -fx-border-color: #e5e7eb;
                                             -fx-border-radius: 14;
                                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 12, 0.15, 0, 3);">
                                    <padding>
                                        <Insets top="4" right="4" bottom="4" left="4"/>
                                    </padding>
                                    <TableView fx:id="usersTable"
                                               VBox.vgrow="ALWAYS"
                                               maxHeight="1.7976931348623157E308"
                                               maxWidth="1.7976931348623157E308">
                                        <columns>
                                            <TableColumn fx:id="usernameColumn"
                                                         text="Username"
                                                         prefWidth="220"/>
                                            <TableColumn fx:id="emailColumn"
                                                         text="Email"
                                                         prefWidth="385"/>
                                            <TableColumn fx:id="fullNameColumn"
                                                         text="Full Name"
                                                         prefWidth="280"/>
                                            <TableColumn fx:id="universityColumn"
                                                         text="University"
                                                         prefWidth="350"/>
                                            <TableColumn fx:id="statusColumn"
                                                         text="Status"
                                                         prefWidth="195"/>
                                        </columns>
                                        <placeholder>
                                            <VBox alignment="CENTER" spacing="8" style="-fx-padding: 40;">
                                                <Label text="👤" style="-fx-font-size: 38px;"/>
                                                <Label text="No users found"
                                                       style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                                                <Label text="Registered users will appear here."
                                                       style="-fx-font-size: 12px; -fx-text-fill: #9ca3af;"/>
                                            </VBox>
                                        </placeholder>
                                    </TableView>
                                </VBox>

                                <!-- Action Bar -->
                                <HBox spacing="10" alignment="CENTER_LEFT"
                                      style="-fx-background-color: white;
                                             -fx-padding: 12 18;
                                             -fx-background-radius: 10;
                                             -fx-border-color: #e5e7eb;
                                             -fx-border-radius: 10;">
                                    <Button text="⛔  Suspend User"
                                            onAction="#handleSuspendSelectedUser"
                                            style="-fx-background-color: white;
                                                   -fx-text-fill: #9D2034;
                                                   -fx-font-weight: bold;
                                                   -fx-font-size: 13px;
                                                   -fx-border-color: #9D2034;
                                                   -fx-border-width: 1.5;
                                                   -fx-border-radius: 8;
                                                   -fx-background-radius: 8;
                                                   -fx-padding: 8 18;
                                                   -fx-cursor: hand;"/>
                                    <Button text="✓  Activate User"
                                            onAction="#handleActivateSelectedUser"
                                            style="-fx-background-color: #9D2034;
                                                   -fx-text-fill: white;
                                                   -fx-font-weight: bold;
                                                   -fx-font-size: 13px;
                                                   -fx-background-radius: 8;
                                                   -fx-padding: 8 18;
                                                   -fx-cursor: hand;"/>
                                    <Pane HBox.hgrow="ALWAYS"/>
                                    <Label text="Tip: Users with 3+ flags can be auto-suspended."
                                           style="-fx-font-size: 11px; -fx-text-fill: #9ca3af;"/>
                                </HBox>
                            </VBox>
                        </center>
                    </BorderPane>
                </Tab>

                <!-- ═══════════════════════════════════
                     TAB 2: MASTER POSTS
                ════════════════════════════════════ -->
                <Tab text="Master Posts">
                    <SplitPane dividerPositions="0.62"
                               style="-fx-background-color: transparent;">
                        <items>

                            <!-- LEFT SIDE – Post List -->
                            <VBox spacing="14"
                                  style="-fx-background-color: transparent;">
                                <padding>
                                    <Insets top="20" right="12" bottom="20" left="28"/>
                                </padding>

                                <HBox alignment="CENTER_LEFT" spacing="10">
                                    <Label text="📋  All Marketplace Posts"
                                           style="-fx-font-size: 17px;
                                                  -fx-font-weight: bold;
                                                  -fx-text-fill: #111827;"/>
                                    <Pane HBox.hgrow="ALWAYS"/>
                                    <Label text="Click a row to preview details"
                                           style="-fx-font-size: 12px;
                                                  -fx-text-fill: #6b7280;"/>
                                </HBox>

                                <VBox spacing="0" VBox.vgrow="ALWAYS"
                                      style="-fx-background-color: white;
                                             -fx-background-radius: 14;
                                             -fx-border-color: #e5e7eb;
                                             -fx-border-radius: 14;
                                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 12, 0.15, 0, 3);">
                                    <padding>
                                        <Insets top="4" right="4" bottom="4" left="4"/>
                                    </padding>
                                    <TableView fx:id="masterPostsTable"
                                               VBox.vgrow="ALWAYS">
                                        <columns>
                                            <TableColumn fx:id="postIdColumn"
                                                         text="ID"
                                                         prefWidth="60"/>
                                            <TableColumn fx:id="postTitleColumn"
                                                         text="Title"
                                                         prefWidth="260"/>
                                            <TableColumn fx:id="postTypeColumn"
                                                         text="Type"
                                                         prefWidth="100"/>
                                            <TableColumn fx:id="postOwnerColumn"
                                                         text="Owner"
                                                         prefWidth="150"/>
                                            <TableColumn fx:id="postPriceColumn"
                                                         text="Price"
                                                         prefWidth="110"/>
                                            <TableColumn fx:id="postStatusColumn"
                                                         text="Status"
                                                         prefWidth="110"/>
                                        </columns>
                                        <placeholder>
                                            <VBox alignment="CENTER" spacing="8" style="-fx-padding: 40;">
                                                <Label text="📋" style="-fx-font-size: 38px;"/>
                                                <Label text="No posts found"
                                                       style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                                                <Label text="Marketplace posts will appear here."
                                                       style="-fx-font-size: 12px; -fx-text-fill: #9ca3af;"/>
                                            </VBox>
                                        </placeholder>
                                    </TableView>
                                </VBox>

                                <!-- Action Bar -->
                                <HBox spacing="10" alignment="CENTER_LEFT"
                                      style="-fx-background-color: white;
                                             -fx-padding: 12 18;
                                             -fx-background-radius: 10;
                                             -fx-border-color: #e5e7eb;
                                             -fx-border-radius: 10;">
                                    <Button text="Archive"
                                            onAction="#handleArchiveSelectedPost"
                                            style="-fx-background-color: #9D2034;
                                                   -fx-text-fill: white;
                                                   -fx-font-weight: bold;
                                                   -fx-font-size: 13px;
                                                   -fx-background-radius: 8;
                                                   -fx-padding: 8 18;
                                                   -fx-cursor: hand;"/>
                                    <Button text="Delete"
                                            onAction="#handleDeleteSelectedPost"
                                            style="-fx-background-color: white;
                                                   -fx-text-fill: #9D2034;
                                                   -fx-font-weight: bold;
                                                   -fx-font-size: 13px;
                                                   -fx-border-color: #9D2034;
                                                   -fx-border-width: 1.5;
                                                   -fx-border-radius: 8;
                                                   -fx-background-radius: 8;
                                                   -fx-padding: 8 18;
                                                   -fx-cursor: hand;"/>
                                </HBox>
                            </VBox>
                            
                            <!-- RIGHT SIDE – Post Detail Panel -->
                            <VBox spacing="12"
                                  style="-fx-background-color: white;
                                         -fx-background-radius: 14;
                                         -fx-border-color: #e5e7eb;
                                         -fx-border-radius: 14;
                                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 12, 0.15, 0, 3);">
                                <padding>
                                    <Insets top="20" right="20" bottom="20" left="20"/>
                                </padding>
                                <Label text="Selected Post"
                                       style="-fx-font-size: 18px;
                                              -fx-font-weight: bold;
                                              -fx-text-fill: #9D2034;"/>
                                <Label fx:id="postDetailTitleLabel"
                                       text="No post selected"
                                       wrapText="true"
                                       style="-fx-font-size: 14px;
                                              -fx-font-weight: bold;
                                              -fx-text-fill: #111827;"/>
                                <StackPane style="-fx-background-color: #f3f3f3;
                                                  -fx-border-color: #e5e7eb;
                                                  -fx-border-radius: 8;
                                                  -fx-background-radius: 8;
                                                  -fx-padding: 6;">
                                    <ImageView fx:id="postDetailImageView"
                                               fitWidth="320"
                                               fitHeight="180"
                                               preserveRatio="true"
                                               smooth="true"/>
                                </StackPane>
                                <Label fx:id="postDetailMetaLabel"
                                       text="-"
                                       wrapText="true"
                                       style="-fx-text-fill: #6b7280;
                                              -fx-font-size: 12px;"/>
                                <Label fx:id="postDetailExtraLabel"
                                       text="-"
                                       wrapText="true"
                                       style="-fx-text-fill: #374151;
                                              -fx-font-size: 12px;"/>
                                <TextArea fx:id="postDetailDescriptionArea"
                                          editable="false"
                                          wrapText="true"
                                          prefRowCount="8"
                                          VBox.vgrow="ALWAYS"
                                          style="-fx-border-color: #e5e7eb;
                                                 -fx-border-radius: 8;
                                                 -fx-background-radius: 8;"/>
                            </VBox>
                        </items>
                    </SplitPane>
                </Tab>
                
                <!-- ═══════════════════════════════════
                     TAB 3: FLAGGED POSTS
                ════════════════════════════════════ -->
                <Tab text="Flagged Posts">
                    <VBox spacing="14" VBox.vgrow="ALWAYS"
                          style="-fx-background-color: transparent;">
                        <padding>
                            <Insets top="20" right="28" bottom="20" left="28"/>
                        </padding>

                        <!-- Section header -->
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="🚩  Reported Posts"
                                   style="-fx-font-size: 17px;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #111827;"/>
                            <Pane HBox.hgrow="ALWAYS"/>
                            <Label text="Posts with at least one open report"
                                   style="-fx-font-size: 12px;
                                          -fx-text-fill: #6b7280;"/>
                        </HBox>

                        <!-- Table card -->
                        <VBox spacing="0" VBox.vgrow="ALWAYS"
                              style="-fx-background-color: white;
                                     -fx-background-radius: 14;
                                     -fx-border-color: #e5e7eb;
                                     -fx-border-radius: 14;
                                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 12, 0.15, 0, 3);">
                            <padding>
                                <Insets top="4" right="4" bottom="4" left="4"/>
                            </padding>
                            <TableView fx:id="flaggedPostsTable"
                                       VBox.vgrow="ALWAYS"
                                       maxHeight="1.7976931348623157E308"
                                       maxWidth="1.7976931348623157E308">
                                <columns>
                                    <TableColumn fx:id="flaggedTitleColumn"
                                                 text="Title"
                                                 prefWidth="400"/>
                                    <TableColumn fx:id="flaggedSellerColumn"
                                                 text="Seller"
                                                 prefWidth="200"/>
                                    <TableColumn fx:id="flaggedReasonColumn"
                                                 text="Reason"
                                                 prefWidth="550"/>
                                    <TableColumn fx:id="flaggedStatusColumn"
                                                 text="Status"
                                                 prefWidth="150"/>
                                </columns>
                                <placeholder>
                                    <VBox alignment="CENTER" spacing="8" style="-fx-padding: 45;">
                                        <Label text="🚩" style="-fx-font-size: 42px;"/>
                                        <Label text="No flagged posts"
                                               style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                                        <Label text="Posts reported by users will appear here."
                                               style="-fx-font-size: 12px; -fx-text-fill: #9ca3af;"/>
                                    </VBox>
                                </placeholder>
                            </TableView>
                        </VBox>

                        <!-- Action Bar -->
                        <HBox spacing="10" alignment="CENTER_LEFT"
                              style="-fx-background-color: white;
                                     -fx-padding: 12 18;
                                     -fx-background-radius: 10;
                                     -fx-border-color: #e5e7eb;
                                     -fx-border-radius: 10;">
                            <Button text="Archive Flagged Post"
                                    onAction="#handleArchiveFlaggedPost"
                                    style="-fx-background-color: #9D2034;
                                           -fx-text-fill: white;
                                           -fx-font-weight: bold;
                                           -fx-font-size: 13px;
                                           -fx-background-radius: 8;
                                           -fx-padding: 8 18;
                                           -fx-cursor: hand;"/>
                            <Button text="Clear Flag"
                                    onAction="#handleClearFlag"
                                    style="-fx-background-color: white;
                                           -fx-text-fill: #9D2034;
                                           -fx-font-weight: bold;
                                           -fx-font-size: 13px;
                                           -fx-border-color: #9D2034;
                                           -fx-border-width: 1.5;
                                           -fx-border-radius: 8;
                                           -fx-background-radius: 8;
                                           -fx-padding: 8 18;
                                           -fx-cursor: hand;"/>
                            <Pane HBox.hgrow="ALWAYS"/>
                            <Label text="Archive: removes post • Clear Flag: keeps post, resolves reports"
                                   style="-fx-font-size: 11px; -fx-text-fill: #9ca3af;"/>
                        </HBox>
                    </VBox>
                </Tab>
            </tabs>
        </TabPane>
    </center>

    <!-- =============================================
         BOTTOM STATUS BAR
    ============================================== -->
    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="10"
              style="-fx-padding: 12 24;
                     -fx-background-color: white;
                     -fx-border-color: #e5e7eb;
                     -fx-border-width: 1 0 0 0;">
            <Label fx:id="statusLabel"
                   text="Ready"
                   style="-fx-text-fill: #6b7280;
                          -fx-font-size: 12px;"/>
        </HBox>
    </bottom>

</BorderPane>
